# LumaFlux Intelligence Runtime Configuration
PORT=3000
LUMAFLUX_ENV="development"

# Database configuration (SQLite local default; PostgreSQL DSN supported in future stage)
LUMAFLUX_DB_PATH="./storage/lumaflux.db"
LUMAFLUX_DATABASE_URL=""

# Configurable local video & artifact storage directories
LUMAFLUX_STORAGE_DIR="./storage/videos"
LUMAFLUX_THUMBNAIL_DIR="./storage/thumbnails"
LUMAFLUX_LOG_DIR="./storage/logs"

# Optional Python FastAPI backend URL (when running the Python backend directly or via Tauri sidecar)
LUMAFLUX_FASTAPI_URL=""
LUMAFLUX_BACKEND_HOST="127.0.0.1"
LUMAFLUX_BACKEND_PORT=8420
LUMAFLUX_LOG_LEVEL="INFO"

# AI Studio platform environment variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
